<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode can't generate from build settings. Xcode merges this file with
	     the generated Info.plist (GENERATE_INFOPLIST_FILE = YES).
	     Stow uses no encryption beyond what macOS provides, so App Store Connect
	     doesn't need to ask about export compliance on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The "stow:" URL scheme. The Share menu extension opens stow://inbox to
	     launch Stow when something is shared while it isn't running. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.aaryanjigarpanchal.Stow</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stow</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
