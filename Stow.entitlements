<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Stow itself isn't sandboxed (ENABLE_APP_SANDBOX = NO), so it can run the
	     yt-dlp and ffmpeg it downloads for Download Audio. Only the Share extension
	     is sandboxed. The shelf still saves security-scoped bookmarks, which also
	     work outside the sandbox and follow files that move. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- A folder shared with the Share menu extension, where it leaves what you
	     share for Stow to pick up (see ShareInbox.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>2MUHC6TNGW.com.aaryanjigarpanchal.Stow</string>
	</array>
</dict>
</plist>
